<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:animateLayoutChanges="true"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="@color/primary_dark"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:text="Smart Pantry Manager&#10;&#10;Optional recipe ingredients are supported.&#10;Recipe preparation methods are supported.&#10;Required ingredients are matched using ingredient name, quantity and compatible units."
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:padding="16dp" />

    <Button
        android:id="@+id/btnClearPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_button_secondary"
        android:text="Clear Pantry"
        android:textColor="@color/danger" />

</LinearLayout>